// Catálogo local: homebrew para PS5 ya en modo homebrew (payloads .elf que se envían a un ELF loader).
// Con "repo", los ficheros descargables salen de la última release de GitHub (con su SHA-256),
// sin listarlos aquí: si el autor publica un fichero nuevo, aparece solo.
// "assets" es opcional: etiquetas y descripciones para los ficheros cuyo nombre encaje (* y ?).
{
  "schemaVersion": 1,
  "apps": [
    {
      "id": "github:ps5-payload-dev/ftpsrv",
      "name": "ftpsrv",
      "author": "ps5-payload-dev",
      "repo": "ps5-payload-dev/ftpsrv",
      "description": "Servidor FTP para la consola (puerto 2121). Permite copiar archivos entre el PC y la PS5 con cualquier cliente FTP (FileZilla, curl…).",
      "iconUrl": "https://avatars.githubusercontent.com/u/166182419?s=256",
      "assets": [
        { "match": "*-ps5.elf", "label": "Payload", "description": "Se envía al ELF loader cada vez que quieras usarlo." },
        { "match": "*-ps5-install.elf", "label": "Instalador", "description": "Lo añade como icono al menú de la consola (necesita websrv)." },
        { "match": "*-ps4.elf", "label": "Payload", "description": "Versión para PS4." }
      ]
    },
    {
      "id": "github:drakmor/nanoDNS",
      "name": "nanoDNS",
      "author": "Drakmor",
      "repo": "drakmor/nanoDNS",
      "description": "Proxy DNS que se ejecuta en la propia consola, con reglas por dominio y registro de consultas. Su configuración por defecto bloquea los servidores de PlayStation (PSN y actualizaciones); se cambia en /data/nanodns/nanodns.ini.",
      "iconUrl": "https://avatars.githubusercontent.com/u/1344732?s=256",
      "assets": [
        { "match": "nanodns.elf", "label": "Payload" },
        { "match": "nanodns-ps4.elf", "label": "Payload", "description": "Versión para PS4." }
      ]
    },
    {
      "id": "github:earthonion/garlic-savemgr",
      "name": "Garlic SaveMgr",
      "author": "earthonion",
      "repo": "earthonion/garlic-savemgr",
      "description": "Gestor local de partidas guardadas con interfaz web: explora, exporta e importa tus saves desde el navegador del PC (http://<ip-de-la-ps5>:8082).",
      "iconUrl": "https://avatars.githubusercontent.com/u/3332298?s=256",
      "assets": [
        { "match": "*.elf", "label": "Payload" }
      ]
    }
  ]
}
