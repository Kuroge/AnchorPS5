<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AnchorPS5.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:AnchorPS5.App.Localization">

    <!-- Armazón de navegación; el contenido de cada sección llega en fases posteriores. -->
    <NavigationView
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        PaneDisplayMode="Left">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="{l:Loc Key=nav.catalog}" Icon="Library" IsSelected="True" />
        </NavigationView.MenuItems>
        <NavigationView.FooterMenuItems>
            <NavigationViewItem Content="{l:Loc Key=nav.guide}" Icon="Help" />
        </NavigationView.FooterMenuItems>
    </NavigationView>
</Window>
