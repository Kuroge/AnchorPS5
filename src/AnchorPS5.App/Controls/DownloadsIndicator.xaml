<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AnchorPS5.App.Controls.DownloadsIndicator"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:AnchorPS5.App.Localization"
    xmlns:vm="using:AnchorPS5.App.ViewModels">

    <!-- Botón de la barra de título: icono de descargas, anillo mientras hay alguna en
         marcha y contador. Al pulsarlo, la lista con progreso, cancelar y reintentar. -->
    <Button
        Width="40"
        Height="32"
        Padding="0"
        AutomationProperties.Name="{l:Loc Key=downloads.title}"
        Background="Transparent"
        BorderThickness="0"
        ToolTipService.ToolTip="{l:Loc Key=downloads.title}">
        <Grid>
            <ProgressRing
                Width="26"
                Height="26"
                IsActive="{x:Bind ViewModel.HasActive, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasActive, Mode=OneWay}" />
            <FontIcon FontSize="14" Glyph="&#xE896;" />
            <InfoBadge
                Margin="0,-6,-10,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Visibility="{x:Bind ViewModel.HasActive, Mode=OneWay}"
                Value="{x:Bind ViewModel.ActiveCount, Mode=OneWay}" />
        </Grid>

        <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel Width="360" Spacing="12">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{l:Loc Key=downloads.title}" />
                    <TextBlock
                        Style="{StaticResource SecondaryTextStyle}"
                        Text="{l:Loc Key=downloads.empty}"
                        Visibility="{x:Bind ViewModel.HasNoJobs, Mode=OneWay}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Jobs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DownloadJobViewModel">
                                <Grid Margin="0,0,0,12" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                    <TextBlock TextTrimming="CharacterEllipsis">
                                        <Run FontWeight="SemiBold" Text="{x:Bind Name}" />
                                        <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind VersionText}" />
                                    </TextBlock>
                                    <ProgressBar
                                        Grid.Row="1"
                                        IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                                        ShowError="{x:Bind IsFailed, Mode=OneWay}"
                                        Value="{x:Bind ProgressValue, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Style="{StaticResource CaptionSecondaryTextStyle}"
                                        Text="{x:Bind StatusText, Mode=OneWay}" />
                                    <StackPanel
                                        Grid.RowSpan="3"
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <Button
                                            Padding="6"
                                            AutomationProperties.Name="{l:Loc Key=action.cancel}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{x:Bind CancelCommand}"
                                            ToolTipService.ToolTip="{l:Loc Key=action.cancel}"
                                            Visibility="{x:Bind IsActive, Mode=OneWay}">
                                            <FontIcon FontSize="12" Glyph="&#xE711;" />
                                        </Button>
                                        <Button
                                            Padding="6"
                                            AutomationProperties.Name="{l:Loc Key=action.retry}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{x:Bind RetryCommand}"
                                            ToolTipService.ToolTip="{l:Loc Key=action.retry}"
                                            Visibility="{x:Bind IsFailed, Mode=OneWay}">
                                            <FontIcon FontSize="12" Glyph="&#xE72C;" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Flyout>
        </Button.Flyout>
    </Button>
</UserControl>
