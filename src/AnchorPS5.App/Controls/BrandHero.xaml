<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AnchorPS5.App.Controls.BrandHero"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:AnchorPS5.App.Controls"
    xmlns:l="using:AnchorPS5.App.Localization"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">

    <UserControl.Resources>
        <!-- Halo azul que "respira" detrás del ancla -->
        <Storyboard x:Name="GlowStoryboard" AutoReverse="True" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="GlowScale" Storyboard.TargetProperty="ScaleX" From="0.88" To="1.08" Duration="0:0:2.8">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="GlowScale" Storyboard.TargetProperty="ScaleY" From="0.88" To="1.08" Duration="0:0:2.8">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" From="0.55" To="1" Duration="0:0:2.8">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- El ancla flota -->
        <Storyboard x:Name="FloatStoryboard" AutoReverse="True" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="AnchorFloat" Storyboard.TargetProperty="Y" From="-6" To="6" Duration="0:0:3.4">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Bokeh azul a la deriva (como el arranque de PS5) -->
        <Storyboard x:Name="BokehStoryboard" AutoReverse="True" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="Bokeh1Move" Storyboard.TargetProperty="X" From="-10" To="14" Duration="0:0:7" />
            <DoubleAnimation Storyboard.TargetName="Bokeh1Move" Storyboard.TargetProperty="Y" From="6" To="-12" Duration="0:0:9" />
            <DoubleAnimation Storyboard.TargetName="Bokeh2Move" Storyboard.TargetProperty="X" From="12" To="-10" Duration="0:0:8" />
            <DoubleAnimation Storyboard.TargetName="Bokeh2Move" Storyboard.TargetProperty="Y" From="-8" To="10" Duration="0:0:6" />
            <DoubleAnimation Storyboard.TargetName="Bokeh3Move" Storyboard.TargetProperty="X" From="-6" To="10" Duration="0:0:10" />
            <DoubleAnimation Storyboard.TargetName="Bokeh3Move" Storyboard.TargetProperty="Y" From="10" To="-6" Duration="0:0:7.5" />
        </Storyboard>

        <!-- Chispas doradas que se encienden y apagan a destiempo -->
        <Storyboard x:Name="SparksStoryboard" RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Spark1" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="1" /><LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Spark2" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                <LinearDoubleKeyFrame KeyTime="0:0:0.8" Value="0" /><EasingDoubleKeyFrame KeyTime="0:0:1.3" Value="1" /><LinearDoubleKeyFrame KeyTime="0:0:2.4" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Spark3" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="0" /><EasingDoubleKeyFrame KeyTime="0:0:2.1" Value="1" /><LinearDoubleKeyFrame KeyTime="0:0:3.2" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Spark4" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                <LinearDoubleKeyFrame KeyTime="0:0:0.4" Value="0" /><EasingDoubleKeyFrame KeyTime="0:0:0.9" Value="0.9" /><LinearDoubleKeyFrame KeyTime="0:0:2" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Spark5" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                <LinearDoubleKeyFrame KeyTime="0:0:1.2" Value="0" /><EasingDoubleKeyFrame KeyTime="0:0:1.7" Value="1" /><LinearDoubleKeyFrame KeyTime="0:0:2.8" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Spark6" Storyboard.TargetProperty="Opacity" Duration="0:0:3.2">
                <LinearDoubleKeyFrame KeyTime="0:0:2" Value="0" /><EasingDoubleKeyFrame KeyTime="0:0:2.5" Value="0.85" /><LinearDoubleKeyFrame KeyTime="0:0:3.2" Value="0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <RadialGradientBrush x:Key="SparkBrush">
            <GradientStop Offset="0" Color="#FFFFF4C8" />
            <GradientStop Offset="0.35" Color="#FFF2C14E" />
            <GradientStop Offset="1" Color="#00D4AC28" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="BokehBrush">
            <GradientStop Offset="0" Color="#664DA3FF" />
            <GradientStop Offset="0.7" Color="#334DA3FF" />
            <GradientStop Offset="1" Color="#004DA3FF" />
        </RadialGradientBrush>
    </UserControl.Resources>

    <Grid>
        <!-- Acrílico real detrás del panel -->
        <SystemBackdropElement CornerRadius="12">
            <SystemBackdropElement.SystemBackdrop>
                <DesktopAcrylicBackdrop />
            </SystemBackdropElement.SystemBackdrop>
        </SystemBackdropElement>

        <Border
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#330070D1" />
                    <GradientStop Offset="0.55" Color="#00000000" />
                    <GradientStop Offset="1" Color="#26D4AC28" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid Padding="24" RowDefinitions="*,Auto">
            <Viewbox
                MaxWidth="250"
                MaxHeight="250"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Stretch="Uniform">
                <Grid Width="250" Height="250">
                    <!-- Bokeh -->
                    <Ellipse Width="70" Height="70" Margin="10,20,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{StaticResource BokehBrush}">
                        <Ellipse.RenderTransform><TranslateTransform x:Name="Bokeh1Move" /></Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Width="46" Height="46" Margin="0,0,14,40" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{StaticResource BokehBrush}">
                        <Ellipse.RenderTransform><TranslateTransform x:Name="Bokeh2Move" /></Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Width="30" Height="30" Margin="0,30,30,0" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{StaticResource BokehBrush}">
                        <Ellipse.RenderTransform><TranslateTransform x:Name="Bokeh3Move" /></Ellipse.RenderTransform>
                    </Ellipse>

                    <!-- Halo -->
                    <Ellipse x:Name="Glow" Opacity="0.8" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><ScaleTransform x:Name="GlowScale" /></Ellipse.RenderTransform>
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Offset="0" Color="#990070D1" />
                                <GradientStop Offset="0.6" Color="#330070D1" />
                                <GradientStop Offset="1" Color="#000070D1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <!-- Chispas -->
                    <Canvas>
                        <Ellipse x:Name="Spark1" Canvas.Left="44" Canvas.Top="58" Width="14" Height="14" Fill="{StaticResource SparkBrush}" Opacity="0" />
                        <Ellipse x:Name="Spark2" Canvas.Left="190" Canvas.Top="70" Width="10" Height="10" Fill="{StaticResource SparkBrush}" Opacity="0" />
                        <Ellipse x:Name="Spark3" Canvas.Left="200" Canvas.Top="170" Width="16" Height="16" Fill="{StaticResource SparkBrush}" Opacity="0" />
                        <Ellipse x:Name="Spark4" Canvas.Left="34" Canvas.Top="178" Width="10" Height="10" Fill="{StaticResource SparkBrush}" Opacity="0" />
                        <Ellipse x:Name="Spark5" Canvas.Left="120" Canvas.Top="18" Width="12" Height="12" Fill="{StaticResource SparkBrush}" Opacity="0" />
                        <Ellipse x:Name="Spark6" Canvas.Left="128" Canvas.Top="218" Width="9" Height="9" Fill="{StaticResource SparkBrush}" Opacity="0" />
                    </Canvas>

                    <!-- Ancla -->
                    <c:AnchorMark
                        Width="132"
                        Height="132"
                        Foreground="{ThemeResource AnchorBlueBrush}"
                        RingBrush="{ThemeResource AnchorGoldBrush}">
                        <c:AnchorMark.RenderTransform>
                            <TranslateTransform x:Name="AnchorFloat" />
                        </c:AnchorMark.RenderTransform>
                    </c:AnchorMark>
                </Grid>
            </Viewbox>

            <StackPanel Grid.Row="1" Spacing="6">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{l:Loc Key=app.title}" />
                <TextBlock
                    x:Name="VersionText"
                    Margin="0,-4,0,0"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{l:Loc Key=app.tagline}" />
                <PipsPager
                    x:Name="Pips"
                    Margin="-4,8,0,0"
                    IsHitTestVisible="False"
                    NextButtonVisibility="Collapsed"
                    PreviousButtonVisibility="Collapsed"
                    Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
