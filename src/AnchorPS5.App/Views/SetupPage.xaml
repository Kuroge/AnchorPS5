<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AnchorPS5.App.Views.SetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:AnchorPS5.App.Localization"
    Background="Transparent">

    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16">
        <StackPanel Spacing="6">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{l:Loc Key=setup.title}" />
            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{l:Loc Key=setup.subtitle}" />
        </StackPanel>

        <ScrollViewer
            Grid.Row="1"
            Padding="0,0,12,0"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8">
                <!-- Idioma -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                        <FontIcon
                            FontSize="20"
                            Foreground="{ThemeResource AnchorBlueBrush}"
                            Glyph="&#xE774;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{l:Loc Key=setup.language}" />
                            <TextBlock Style="{StaticResource CaptionSecondaryTextStyle}" Text="{l:Loc Key=setup.languageDescription}" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="2"
                            MinWidth="180"
                            VerticalAlignment="Center"
                            DisplayMemberPath="Name"
                            ItemsSource="{x:Bind ViewModel.Languages}"
                            SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <!-- Carpeta de descargas -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" RowDefinitions="Auto,Auto" RowSpacing="12">
                        <FontIcon
                            FontSize="20"
                            Foreground="{ThemeResource AnchorBlueBrush}"
                            Glyph="&#xE8B7;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{l:Loc Key=setup.downloadFolder}" />
                            <TextBlock Style="{StaticResource CaptionSecondaryTextStyle}" Text="{l:Loc Key=setup.downloadFolderDescription}" />
                        </StackPanel>
                        <Grid
                            Grid.Row="1"
                            Grid.Column="1"
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="8">
                            <TextBox
                                AutomationProperties.Name="{l:Loc Key=setup.downloadFolder}"
                                Text="{x:Bind ViewModel.DownloadPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Command="{x:Bind ViewModel.BrowseCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE838;" />
                                    <TextBlock Text="{l:Loc Key=setup.browse}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Cuenta de GitHub (opcional) -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                        <FontIcon
                            FontSize="20"
                            Foreground="{ThemeResource AnchorBlueBrush}"
                            Glyph="&#xE77B;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{l:Loc Key=github.account}" />
                            <TextBlock
                                Style="{StaticResource CaptionSecondaryTextStyle}"
                                Text="{l:Loc Key=setup.githubDescription}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            x:Name="GitHubSignInButton"
                            AutomationProperties.Name="{l:Loc Key=github.signIn}"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Click="OnGitHubSignInClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE77B;" />
                                <TextBlock Text="{l:Loc Key=github.signIn}" />
                            </StackPanel>
                        </Button>
                        <StackPanel
                            x:Name="GitHubSignedInPanel"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="10"
                            Visibility="Collapsed">
                            <PersonPicture x:Name="GitHubPicture" Width="32" Height="32" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="GitHubSignedInText" />
                                <HyperlinkButton
                                    Padding="0"
                                    Click="OnGitHubSignOutClick"
                                    Content="{l:Loc Key=github.signOut}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Severity="Error" />
            </StackPanel>
        </ScrollViewer>

        <Button
            Grid.Row="2"
            MinWidth="150"
            HorizontalAlignment="Right"
            AutomationProperties.Name="{l:Loc Key=setup.confirm}"
            Command="{x:Bind ViewModel.ConfirmCommand}"
            Style="{StaticResource AccentButtonStyle}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{l:Loc Key=setup.confirm}" />
                <FontIcon FontSize="14" Glyph="&#xE72A;" />
            </StackPanel>
        </Button>
    </Grid>
</Page>
