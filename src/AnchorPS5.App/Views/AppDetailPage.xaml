<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AnchorPS5.App.Views.AppDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:AnchorPS5.App.Localization"
    xmlns:vm="using:AnchorPS5.App.ViewModels"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="InfoIconStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{ThemeResource AnchorBlueBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="InfoLabelStyle" BasedOn="{StaticResource BodyTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="InfoValueStyle" BasedOn="{StaticResource BodyTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="IsTextSelectionEnabled" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel
            MaxWidth="960"
            Padding="32,20,32,32"
            Spacing="8">

            <!-- Cabecera -->
            <Grid Margin="0,0,0,16" CornerRadius="12">
                <Border
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="#330070D1" />
                            <GradientStop Offset="0.6" Color="#0D0070D1" />
                            <GradientStop Offset="1" Color="#26D4AC28" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Grid
                    Padding="24"
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="24">
                    <Grid
                        Width="120"
                        Height="120"
                        CornerRadius="24">
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#1A8CFF" />
                                <GradientStop Offset="1" Color="#003791" />
                            </LinearGradientBrush>
                        </Grid.Background>
                        <FontIcon
                            FontSize="52"
                            Foreground="White"
                            Glyph="&#xE7B8;" />
                        <Image Source="{x:Bind Item.Icon}" Stretch="UniformToFill" />
                    </Grid>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="8">
                        <TextBlock
                            Style="{StaticResource TitleLargeTextBlockStyle}"
                            Text="{x:Bind Item.Name}"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE77B;" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Item.Author}" />
                        </StackPanel>
                        <StackPanel
                            Margin="0,4,0,0"
                            Orientation="Horizontal"
                            Spacing="6">
                            <Border
                                Background="{ThemeResource AnchorGoldBrush}"
                                Style="{StaticResource ChipStyle}"
                                Visibility="{x:Bind Item.IsNew}">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Foreground="#1C1C1C"
                                    Text="{l:Loc Key=status.new}" />
                            </Border>
                            <Border Style="{StaticResource ChipStyle}" Visibility="{x:Bind Item.HasVersion}">
                                <TextBlock Foreground="{ThemeResource AnchorBlueBrush}" Text="{x:Bind Item.VersionText}" />
                            </Border>
                            <Border
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                Style="{StaticResource ChipStyle}"
                                Visibility="{x:Bind Item.HasSize}">
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Item.SizeText}" />
                            </Border>
                            <Border Background="{ThemeResource AnchorGoldTintBrush}" Style="{StaticResource ChipStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon
                                        FontSize="12"
                                        Foreground="{ThemeResource AnchorGoldBrush}"
                                        Glyph="{x:Bind Item.SourceGlyph}" />
                                    <TextBlock Foreground="{ThemeResource AnchorGoldBrush}" Text="{x:Bind Item.SourceName}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Acciones -->
                        <StackPanel
                            Margin="0,10,0,0"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                MinWidth="140"
                                AutomationProperties.Name="{l:Loc Key=action.download}"
                                Command="{x:Bind Item.DownloadCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                Visibility="{x:Bind Item.ShowDownloadButton, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE896;" />
                                    <TextBlock Text="{l:Loc Key=action.download}" />
                                </StackPanel>
                            </Button>
                            <Button
                                MinWidth="140"
                                AutomationProperties.Name="{x:Bind Item.UpdateButtonText}"
                                Command="{x:Bind Item.DownloadCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                Visibility="{x:Bind Item.ShowUpdateButton, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE74A;" />
                                    <TextBlock Text="{x:Bind Item.UpdateButtonText}" />
                                </StackPanel>
                            </Button>
                            <Button
                                AutomationProperties.Name="{l:Loc Key=action.openFolder}"
                                Command="{x:Bind Item.OpenFolderCommand}"
                                Visibility="{x:Bind Item.HasInstalledVersions, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE838;" />
                                    <TextBlock Text="{l:Loc Key=action.openFolder}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Descarga en curso -->
                        <Grid
                            MaxWidth="460"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Left"
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="12"
                            Visibility="{x:Bind Item.IsBusy, Mode=OneWay}">
                            <StackPanel VerticalAlignment="Center" Spacing="6">
                                <ProgressBar
                                    MinWidth="320"
                                    IsIndeterminate="{x:Bind Item.ActiveJob.IsIndeterminate, Mode=OneWay, FallbackValue=True}"
                                    Value="{x:Bind Item.ActiveJob.ProgressValue, Mode=OneWay, FallbackValue=0}" />
                                <TextBlock Style="{StaticResource CaptionSecondaryTextStyle}" Text="{x:Bind Item.ActiveJob.StatusText, Mode=OneWay, FallbackValue=''}" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Command="{x:Bind Item.CancelDownloadCommand}"
                                Content="{l:Loc Key=action.cancel}" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Errores -->
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind Item.HasJobError, Mode=OneWay}"
                Message="{x:Bind Item.ActiveJob.StatusText, Mode=OneWay, FallbackValue=''}"
                Severity="Error"
                Title="{l:Loc Key=download.failedTitle}">
                <InfoBar.ActionButton>
                    <Button Command="{x:Bind Item.RetryDownloadCommand}" Content="{l:Loc Key=action.retry}" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar
                IsClosable="True"
                IsOpen="{x:Bind Item.HasActionError, Mode=OneWay}"
                Message="{x:Bind Item.ActionError, Mode=OneWay}"
                Severity="Error" />

            <!-- Estado -->
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{l:Loc Key=detail.statusTitle}" />
            <StackPanel Margin="0,0,0,16" Spacing="4">
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                        <Button
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{l:Loc Key=action.deleteAll}"
                            Visibility="{x:Bind Item.HasInstalledVersions, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                <TextBlock Text="{l:Loc Key=action.deleteAll}" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout x:Name="DeleteAllFlyout">
                                    <StackPanel MaxWidth="320" Spacing="12">
                                        <TextBlock Text="{x:Bind Item.DeleteAllConfirmText}" TextWrapping="Wrap" />
                                        <Button
                                            AutomationProperties.Name="{l:Loc Key=action.confirmDelete}"
                                            Click="OnDeleteAllConfirmed"
                                            Content="{l:Loc Key=action.confirmDelete}"
                                            Style="{StaticResource AccentButtonStyle}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Grid Width="40" Height="40">
                            <Ellipse Fill="{ThemeResource ControlFillColorSecondaryBrush}" Visibility="{x:Bind Item.IsNotDownloaded, Mode=OneWay}" />
                            <Ellipse Fill="{ThemeResource AnchorBlueTintBrush}" Visibility="{x:Bind Item.IsDownloaded, Mode=OneWay}" />
                            <Ellipse Fill="{ThemeResource AnchorGoldTintBrush}" Visibility="{x:Bind Item.HasUpdate, Mode=OneWay}" />
                            <FontIcon
                                FontSize="18"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE896;"
                                Visibility="{x:Bind Item.IsNotDownloaded, Mode=OneWay}" />
                            <FontIcon
                                FontSize="18"
                                Foreground="{ThemeResource AnchorBlueBrush}"
                                Glyph="&#xE73E;"
                                Visibility="{x:Bind Item.IsDownloaded, Mode=OneWay}" />
                            <FontIcon
                                FontSize="18"
                                Foreground="{ThemeResource AnchorGoldBrush}"
                                Glyph="&#xE74A;"
                                Visibility="{x:Bind Item.HasUpdate, Mode=OneWay}" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Item.StatusTitle, Mode=OneWay}" />
                            <TextBlock
                                IsTextSelectionEnabled="True"
                                Style="{StaticResource CaptionSecondaryTextStyle}"
                                Text="{x:Bind Item.StatusDetail, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Versiones descargadas -->
                <ItemsControl ItemsSource="{x:Bind Item.InstalledVersions, Mode=OneWay}">
                    <ItemsControl.ItemContainerTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition IsStaggeringEnabled="True" />
                        </TransitionCollection>
                    </ItemsControl.ItemContainerTransitions>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:InstalledVersionViewModel">
                            <Border
                                Margin="0,4,0,0"
                                Padding="16,10"
                                Style="{StaticResource CardStyle}">
                                <Grid ColumnDefinitions="40,Auto,*,Auto" ColumnSpacing="16">
                                    <FontIcon
                                        FontSize="16"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Glyph="&#xE8B7;" />
                                    <StackPanel
                                        Grid.Column="3"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="4">
                                        <Button
                                            Padding="8"
                                            AutomationProperties.Name="{l:Loc Key=action.openFolder}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{x:Bind OpenCommand}"
                                            ToolTipService.ToolTip="{l:Loc Key=action.openFolder}">
                                            <FontIcon FontSize="14" Glyph="&#xE838;" />
                                        </Button>
                                        <Button
                                            Padding="8"
                                            AutomationProperties.Name="{l:Loc Key=action.delete}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            ToolTipService.ToolTip="{l:Loc Key=action.delete}">
                                            <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                            <Button.Flyout>
                                                <Flyout>
                                                    <StackPanel MaxWidth="320" Spacing="12">
                                                        <TextBlock Text="{x:Bind DeleteConfirmText}" TextWrapping="Wrap" />
                                                        <Button
                                                            AutomationProperties.Name="{l:Loc Key=action.confirmDelete}"
                                                            Command="{x:Bind DeleteCommand}"
                                                            Content="{l:Loc Key=action.confirmDelete}"
                                                            Style="{StaticResource AccentButtonStyle}" />
                                                    </StackPanel>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind Version}" />
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource CaptionSecondaryTextStyle}" Text="{x:Bind Detail}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            IsTextSelectionEnabled="True"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind FolderPath}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Descripción -->
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{l:Loc Key=detail.descriptionTitle}" />
            <Border Margin="0,0,0,16" Style="{StaticResource CardStyle}">
                <TextBlock
                    IsTextSelectionEnabled="True"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind Item.Description}" />
            </Border>

            <!-- Información -->
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{l:Loc Key=detail.informationTitle}" />
            <Border Style="{StaticResource CardStyle}">
                <Grid
                    ColumnDefinitions="Auto,Auto,*"
                    ColumnSpacing="16"
                    RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                    RowSpacing="14">
                    <FontIcon Glyph="&#xE8EC;" Style="{StaticResource InfoIconStyle}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource InfoLabelStyle}" Text="{l:Loc Key=detail.version}" />
                    <TextBlock Grid.Column="2" Style="{StaticResource InfoValueStyle}" Text="{x:Bind Item.Version}" />

                    <FontIcon Grid.Row="1" Glyph="&#xE77B;" Style="{StaticResource InfoIconStyle}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource InfoLabelStyle}" Text="{l:Loc Key=detail.author}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource InfoValueStyle}" Text="{x:Bind Item.Author}" />

                    <FontIcon Grid.Row="2" Glyph="&#xEDA2;" Style="{StaticResource InfoIconStyle}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource InfoLabelStyle}" Text="{l:Loc Key=detail.size}" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource InfoValueStyle}" Text="{x:Bind Item.SizeText}" />

                    <FontIcon Grid.Row="3" Glyph="{x:Bind Item.SourceGlyph}" Style="{StaticResource InfoIconStyle}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource InfoLabelStyle}" Text="{l:Loc Key=detail.source}" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource InfoValueStyle}" Text="{x:Bind Item.SourceName}" />

                    <FontIcon Grid.Row="4" Glyph="&#xE943;" Style="{StaticResource InfoIconStyle}" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource InfoLabelStyle}" Text="{l:Loc Key=detail.id}" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource InfoValueStyle}" Text="{x:Bind Item.Id}" />

                    <FontIcon Grid.Row="5" Glyph="&#xE72E;" Style="{StaticResource InfoIconStyle}" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource InfoLabelStyle}" Text="{l:Loc Key=detail.sha256}" />
                    <Grid Grid.Row="5" Grid.Column="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock
                            FontFamily="Cascadia Mono, Consolas"
                            FontSize="13"
                            Style="{StaticResource InfoValueStyle}"
                            Text="{x:Bind Item.Sha256}"
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="CopyShaButton"
                            Grid.Column="1"
                            Padding="8"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{l:Loc Key=detail.copy}"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnCopyShaClick"
                            ToolTipService.ToolTip="{l:Loc Key=detail.copy}">
                            <FontIcon
                                x:Name="CopyShaIcon"
                                FontSize="14"
                                Glyph="&#xE8C8;" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
