<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AnchorPS5.App.Views.AppDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:AnchorPS5.App.Controls"
    xmlns:l="using:AnchorPS5.App.Localization"
    xmlns:vm="using:AnchorPS5.App.ViewModels"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="InfoIconStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{ThemeResource AnchorBlueBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="InfoLabelStyle" BasedOn="{StaticResource BodyTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="InfoValueStyle" BasedOn="{StaticResource BodyTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="IsTextSelectionEnabled" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Botón de icono sin fondo (abrir carpeta, borrar) -->
        <Style x:Key="IconButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
            <Setter Property="Padding" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel
            MaxWidth="960"
            Padding="32,20,32,32"
            Spacing="8">

            <!-- Volver, junto al contenido (en pantallas grandes la barra queda lejos) -->
            <Button
                Margin="-8,0,0,4"
                Padding="8,4"
                AutomationProperties.Name="{l:Loc Key=action.back}"
                Background="Transparent"
                BorderThickness="0"
                Click="OnBackClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="12" Glyph="&#xE72B;" />
                    <TextBlock Text="{l:Loc Key=action.back}" />
                </StackPanel>
            </Button>

            <!-- Cabecera -->
            <Grid Margin="0,0,0,16" CornerRadius="12">
                <Border
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="#330070D1" />
                            <GradientStop Offset="0.6" Color="#0D0070D1" />
                            <GradientStop Offset="1" Color="#26D4AC28" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Grid
                    Padding="24"
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="24">
                    <Grid
                        Width="120"
                        Height="120"
                        CornerRadius="24">
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#1A8CFF" />
                                <GradientStop Offset="1" Color="#003791" />
                            </LinearGradientBrush>
                        </Grid.Background>
                        <FontIcon
                            FontSize="52"
                            Foreground="White"
                            Glyph="&#xE7B8;" />
                        <Image Source="{x:Bind Item.Icon}" Stretch="UniformToFill" />
                    </Grid>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="8">
                        <TextBlock
                            Style="{StaticResource TitleLargeTextBlockStyle}"
                            Text="{x:Bind Item.Name}"
                            TextWrapping="Wrap" />
                        <!-- Autor: enlace a su perfil de GitHub (si la app viene de GitHub) -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE77B;" />
                            <HyperlinkButton
                                Padding="0"
                                AutomationProperties.Name="{x:Bind Item.Author}"
                                Content="{x:Bind Item.Author}"
                                NavigateUri="{x:Bind Item.AuthorUrl}"
                                ToolTipService.ToolTip="{x:Bind Item.AuthorUrl}"
                                Visibility="{x:Bind Item.HasAuthorUrl}" />
                            <TextBlock
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="{x:Bind Item.Author}"
                                Visibility="{x:Bind Item.HasNoAuthorUrl}" />
                        </StackPanel>

                        <!-- Descripción -->
                        <TextBlock
                            MaxWidth="720"
                            HorizontalAlignment="Left"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind Item.Description}"
                            TextWrapping="Wrap" />

                        <StackPanel
                            Margin="0,4,0,0"
                            Orientation="Horizontal"
                            Spacing="6">
                            <Border
                                Background="{ThemeResource AnchorGoldBrush}"
                                Style="{StaticResource ChipStyle}"
                                Visibility="{x:Bind Item.IsNew}">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Foreground="#1C1C1C"
                                    Text="{l:Loc Key=status.new}" />
                            </Border>
                            <!-- Resumen de actualizaciones -->
                            <Border
                                Background="{ThemeResource AnchorGoldTintBrush}"
                                Style="{StaticResource ChipStyle}"
                                Visibility="{x:Bind Item.HasUpdate, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon
                                        FontSize="12"
                                        Foreground="{ThemeResource AnchorGoldBrush}"
                                        Glyph="&#xE74A;" />
                                    <TextBlock Foreground="{ThemeResource AnchorGoldBrush}" Text="{x:Bind Item.StatusText, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource ChipStyle}" Visibility="{x:Bind Item.HasVersion}">
                                <TextBlock Foreground="{ThemeResource AnchorBlueBrush}" Text="{x:Bind Item.VersionText}" />
                            </Border>
                            <Border
                                Background="{ThemeResource BetaTintBrush}"
                                Style="{StaticResource ChipStyle}"
                                Visibility="{x:Bind Item.HasBeta}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <c:BetaIcon
                                        Width="12"
                                        Height="12"
                                        Foreground="{ThemeResource BetaBrush}" />
                                    <TextBlock Foreground="{ThemeResource BetaBrush}" Text="{x:Bind Item.BetaText}" />
                                </StackPanel>
                            </Border>
                            <!-- Origen: oficial (dorado), añadida por ti (naranja) u otro catálogo -->
                            <Border
                                Background="{ThemeResource AnchorGoldTintBrush}"
                                Style="{StaticResource ChipStyle}"
                                Visibility="{x:Bind Item.IsOfficialOrigin}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon
                                        FontSize="12"
                                        Foreground="{ThemeResource AnchorGoldBrush}"
                                        Glyph="{x:Bind Item.OriginGlyph}" />
                                    <TextBlock Foreground="{ThemeResource AnchorGoldBrush}" Text="{x:Bind Item.OriginText}" />
                                </StackPanel>
                            </Border>
                            <Border
                                Background="{ThemeResource BetaTintBrush}"
                                Style="{StaticResource ChipStyle}"
                                Visibility="{x:Bind Item.IsCustomOrigin}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon
                                        FontSize="12"
                                        Foreground="{ThemeResource BetaBrush}"
                                        Glyph="{x:Bind Item.OriginGlyph}" />
                                    <TextBlock Foreground="{ThemeResource BetaBrush}" Text="{x:Bind Item.OriginText}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource ChipStyle}" Visibility="{x:Bind Item.IsExternalOrigin}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="12" Glyph="{x:Bind Item.OriginGlyph}" />
                                    <TextBlock Text="{x:Bind Item.OriginText}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Acciones -->
                        <StackPanel
                            Margin="0,10,0,0"
                            Orientation="Horizontal"
                            Spacing="8">
                            <!-- Un solo fichero: Descargar -->
                            <Button
                                MinWidth="140"
                                AutomationProperties.Name="{l:Loc Key=action.download}"
                                Command="{x:Bind Item.DownloadCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                Visibility="{x:Bind Item.ShowDownloadButton, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE896;" />
                                    <TextBlock Text="{l:Loc Key=action.download}" />
                                </StackPanel>
                            </Button>
                            <!-- Todo en la última versión: botón en gris -->
                            <Button
                                MinWidth="140"
                                AutomationProperties.Name="{l:Loc Key=action.upToDate}"
                                IsEnabled="False"
                                Visibility="{x:Bind Item.IsAllUpToDate, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE73E;" />
                                    <TextBlock Text="{l:Loc Key=action.upToDate}" />
                                </StackPanel>
                            </Button>
                            <!-- Varios ficheros: el usuario elige -->
                            <DropDownButton
                                MinWidth="140"
                                AutomationProperties.Name="{l:Loc Key=action.chooseDownload}"
                                Style="{StaticResource AccentButtonStyle}"
                                Visibility="{x:Bind Item.ShowDownloadMenu, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE896;" />
                                    <TextBlock Text="{l:Loc Key=action.download}" />
                                    <FontIcon
                                        Margin="2,0,0,0"
                                        FontSize="10"
                                        Glyph="&#xE70D;" />
                                </StackPanel>
                                <DropDownButton.Flyout>
                                    <MenuFlyout
                                        x:Name="DownloadMenu"
                                        Opening="OnDownloadMenuOpening"
                                        Placement="BottomEdgeAlignedLeft" />
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <Button
                                MinWidth="140"
                                AutomationProperties.Name="{l:Loc Key=action.updateAll}"
                                Command="{x:Bind Item.UpdateAllCommand}"
                                Visibility="{x:Bind Item.ShowUpdateButton, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        FontSize="16"
                                        Foreground="{ThemeResource AnchorGoldBrush}"
                                        Glyph="&#xE74A;" />
                                    <TextBlock Text="{l:Loc Key=action.updateAll}" />
                                </StackPanel>
                            </Button>
                            <!-- Carpeta de la app: <descargas>\<App> -->
                            <Button
                                AutomationProperties.Name="{l:Loc Key=action.openFolder}"
                                Command="{x:Bind Item.OpenFolderCommand}"
                                Visibility="{x:Bind Item.HasInstalledVersions, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE838;" />
                                    <TextBlock Text="{l:Loc Key=action.openFolder}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <InfoBar
                IsClosable="True"
                IsOpen="{x:Bind Item.HasActionError, Mode=OneWay}"
                Message="{x:Bind Item.ActionError, Mode=OneWay}"
                Severity="Error" />

            <!-- Archivos: título + "Eliminar todas" (de la app entera) -->
            <Grid ColumnDefinitions="*,Auto" Visibility="{x:Bind Item.HasFiles, Mode=OneWay}">
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind Item.FilesTitle}" />
                <Button
                    Grid.Column="1"
                    AutomationProperties.Name="{l:Loc Key=action.deleteAll}"
                    Click="OnDeleteAllClick"
                    Visibility="{x:Bind Item.HasInstalledVersions, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                        <TextBlock Text="{l:Loc Key=action.deleteAll}" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Fichas de los ficheros: se despliegan con su histórico de versiones -->
            <ItemsControl
                Margin="0,0,0,16"
                ItemsSource="{x:Bind Item.Files}"
                Visibility="{x:Bind Item.HasFiles, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PackageFileViewModel">
                        <Grid Margin="0,0,0,8">
                            <!-- Actualización: tinte dorado detrás (la ficha es semitransparente) -->
                            <Border
                                Background="{ThemeResource AnchorGoldTintBrush}"
                                CornerRadius="8"
                                Visibility="{x:Bind HighlightUpdate}" />

                            <Expander
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                AutomationProperties.Name="{x:Bind Label}">
                                <Expander.Header>
                                    <Grid
                                        Padding="0,12"
                                        ColumnDefinitions="Auto,*,Auto"
                                        ColumnSpacing="16">
                                        <FontIcon
                                            FontSize="18"
                                            Foreground="{ThemeResource AnchorBlueBrush}"
                                            Glyph="&#xE7C3;" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                                    Text="{x:Bind Label}" />
                                                <Border Style="{StaticResource Ps4BadgeStyle}" Visibility="{x:Bind IsPs4}">
                                                    <TextBlock
                                                        FontSize="12"
                                                        FontWeight="Bold"
                                                        Foreground="Black"
                                                        Text="PS4" />
                                                </Border>
                                                <StackPanel
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="4"
                                                    Visibility="{x:Bind IsBeta}">
                                                    <c:BetaIcon
                                                        Width="13"
                                                        Height="13"
                                                        Foreground="{ThemeResource BetaBrush}" />
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Foreground="{ThemeResource BetaBrush}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="{l:Loc Key=file.beta}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock
                                                Style="{StaticResource CaptionSecondaryTextStyle}"
                                                Text="{x:Bind FileName}"
                                                Visibility="{x:Bind HasLabel}" />
                                            <TextBlock
                                                Style="{StaticResource CaptionSecondaryTextStyle}"
                                                Text="{x:Bind Description}"
                                                Visibility="{x:Bind HasDescription}" />
                                            <TextBlock Style="{StaticResource CaptionSecondaryTextStyle}">
                                                <Run Text="{x:Bind StateText}" />
                                                <Run Text="{x:Bind SizeText}" />
                                            </TextBlock>

                                            <!-- Estás en estable y hay una beta más nueva -->
                                            <StackPanel
                                                Margin="0,6,0,0"
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                Visibility="{x:Bind HasBetaOffer}">
                                                <c:BetaIcon
                                                    VerticalAlignment="Center"
                                                    Width="13"
                                                    Height="13"
                                                    Foreground="{ThemeResource BetaBrush}" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource BetaBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind BetaOfferText}" />
                                                <HyperlinkButton
                                                    Padding="4,0"
                                                    AutomationProperties.Name="{x:Bind TryBetaText}"
                                                    Click="OnTryBetaClick"
                                                    Content="{x:Bind TryBetaText}"
                                                    Foreground="{ThemeResource BetaBrush}"
                                                    Tag="{x:Bind}"
                                                    Visibility="{x:Bind ShowTryBetaButton, Mode=OneWay}" />
                                            </StackPanel>

                                            <!-- Progreso de este fichero -->
                                            <StackPanel
                                                Margin="0,6,0,0"
                                                Spacing="4"
                                                Visibility="{x:Bind IsBusy, Mode=OneWay}">
                                                <ProgressBar
                                                    MaxWidth="420"
                                                    HorizontalAlignment="Stretch"
                                                    IsIndeterminate="{x:Bind ActiveJob.IsIndeterminate, Mode=OneWay, FallbackValue=True}"
                                                    Value="{x:Bind ActiveJob.ProgressValue, Mode=OneWay, FallbackValue=0}" />
                                                <TextBlock Style="{StaticResource CaptionSecondaryTextStyle}" Text="{x:Bind ActiveJob.StatusText, Mode=OneWay, FallbackValue=''}" />
                                            </StackPanel>
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind ActiveJob.StatusText, Mode=OneWay, FallbackValue=''}"
                                                TextWrapping="Wrap"
                                                Visibility="{x:Bind HasJobError, Mode=OneWay}" />
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="4">
                                            <FontIcon
                                                Margin="0,0,4,0"
                                                FontSize="16"
                                                Foreground="{ThemeResource AnchorBlueBrush}"
                                                Glyph="&#xE73E;"
                                                ToolTipService.ToolTip="{x:Bind StateText}"
                                                Visibility="{x:Bind IsUpToDate}" />
                                            <!-- Carpeta del fichero: <App>\<fichero> -->
                                            <Button
                                                AutomationProperties.Name="{l:Loc Key=action.openFileFolder}"
                                                Command="{x:Bind OpenFolderCommand}"
                                                Style="{StaticResource IconButtonStyle}"
                                                ToolTipService.ToolTip="{l:Loc Key=action.openFileFolder}"
                                                Visibility="{x:Bind HasVersions}">
                                                <FontIcon FontSize="14" Glyph="&#xE838;" />
                                            </Button>
                                            <Button
                                                AutomationProperties.Name="{l:Loc Key=action.deleteFile}"
                                                Click="OnDeleteFileClick"
                                                Style="{StaticResource IconButtonStyle}"
                                                Tag="{x:Bind}"
                                                ToolTipService.ToolTip="{l:Loc Key=action.deleteFile}"
                                                Visibility="{x:Bind HasVersions}">
                                                <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                            </Button>
                                            <Button
                                                Margin="4,0,0,0"
                                                AutomationProperties.Name="{l:Loc Key=action.backToStable}"
                                                Click="OnBackToStableClick"
                                                Tag="{x:Bind}"
                                                Content="{l:Loc Key=action.backToStable}"
                                                Visibility="{x:Bind ShowBackToStableButton, Mode=OneWay}" />
                                            <Button
                                                Margin="4,0,0,0"
                                                AutomationProperties.Name="{x:Bind DownloadText}"
                                                Click="OnFileDownloadClick"
                                                Content="{x:Bind DownloadText}"
                                                Tag="{x:Bind}"
                                                Visibility="{x:Bind ShowDownloadButton, Mode=OneWay}" />
                                            <Button
                                                AutomationProperties.Name="{l:Loc Key=action.cancel}"
                                                Command="{x:Bind CancelCommand}"
                                                Content="{l:Loc Key=action.cancel}"
                                                Visibility="{x:Bind IsBusy, Mode=OneWay}" />
                                            <Button
                                                AutomationProperties.Name="{l:Loc Key=action.retry}"
                                                Command="{x:Bind RetryCommand}"
                                                Content="{l:Loc Key=action.retry}"
                                                Visibility="{x:Bind HasJobError, Mode=OneWay}" />
                                        </StackPanel>
                                    </Grid>
                                </Expander.Header>

                                <!-- Histórico de versiones descargadas de este fichero -->
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        Margin="0,0,0,4"
                                        Style="{StaticResource CaptionSecondaryTextStyle}"
                                        Text="{l:Loc Key=file.versionsTitle}"
                                        Visibility="{x:Bind HasVersions}" />
                                    <TextBlock
                                        Style="{StaticResource CaptionSecondaryTextStyle}"
                                        Text="{l:Loc Key=file.noVersions}"
                                        Visibility="{x:Bind HasNoVersions}" />
                                    <ItemsControl ItemsSource="{x:Bind Versions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:FileVersionViewModel">
                                                <Grid
                                                    Padding="0,4"
                                                    ColumnDefinitions="Auto,*,Auto"
                                                    ColumnSpacing="16">
                                                    <TextBlock
                                                        MinWidth="70"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                                        Text="{x:Bind VersionText}" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Style="{StaticResource CaptionSecondaryTextStyle}" Text="{x:Bind Detail}" />
                                                            <StackPanel
                                                                Orientation="Horizontal"
                                                                Spacing="4"
                                                                Visibility="{x:Bind IsBeta}">
                                                                <c:BetaIcon
                                                                    Width="12"
                                                                    Height="12"
                                                                    Foreground="{ThemeResource BetaBrush}" />
                                                                <TextBlock
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{ThemeResource BetaBrush}"
                                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                                    Text="{l:Loc Key=file.beta}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <TextBlock
                                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                            IsTextSelectionEnabled="True"
                                                            Style="{StaticResource CaptionTextBlockStyle}"
                                                            Text="{x:Bind FolderPath}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <StackPanel
                                                        Grid.Column="2"
                                                        Orientation="Horizontal"
                                                        Spacing="4">
                                                        <!-- Carpeta exacta de esta versión -->
                                                        <Button
                                                            AutomationProperties.Name="{l:Loc Key=action.openVersionFolder}"
                                                            Command="{x:Bind OpenCommand}"
                                                            Style="{StaticResource IconButtonStyle}"
                                                            ToolTipService.ToolTip="{l:Loc Key=action.openVersionFolder}">
                                                            <FontIcon FontSize="14" Glyph="&#xE838;" />
                                                        </Button>
                                                        <Button
                                                            AutomationProperties.Name="{l:Loc Key=action.deleteVersion}"
                                                            Click="OnDeleteVersionClick"
                                                            Style="{StaticResource IconButtonStyle}"
                                                            Tag="{x:Bind}"
                                                            ToolTipService.ToolTip="{l:Loc Key=action.deleteVersion}">
                                                            <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>

                            <!-- Actualización: borde dorado encima -->
                            <Border
                                BorderBrush="{ThemeResource AnchorGoldBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                IsHitTestVisible="False"
                                Visibility="{x:Bind HighlightUpdate}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Información -->
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{l:Loc Key=detail.informationTitle}" />
            <Border Style="{StaticResource CardStyle}">
                <Grid
                    ColumnDefinitions="Auto,Auto,*"
                    ColumnSpacing="16"
                    RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                    RowSpacing="14">
                    <FontIcon Glyph="&#xE8EC;" Style="{StaticResource InfoIconStyle}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource InfoLabelStyle}" Text="{l:Loc Key=detail.version}" />
                    <TextBlock Grid.Column="2" Style="{StaticResource InfoValueStyle}" Text="{x:Bind Item.StableVersionText}" />

                    <!-- Beta disponible (solo si la hay) -->
                    <c:BetaIcon
                        Grid.Row="1"
                        Visibility="{x:Bind Item.HasBeta}"
                        VerticalAlignment="Center"
                        Width="16"
                        Height="16"
                        Foreground="{ThemeResource BetaBrush}" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource InfoLabelStyle}"
                        Text="{l:Loc Key=detail.betaVersion}"
                        Visibility="{x:Bind Item.HasBeta}" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="2"
                        Style="{StaticResource InfoValueStyle}"
                        Text="{x:Bind Item.Package.BetaVersion}"
                        Visibility="{x:Bind Item.HasBeta}" />

                    <FontIcon Grid.Row="2" Glyph="&#xE77B;" Style="{StaticResource InfoIconStyle}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource InfoLabelStyle}" Text="{l:Loc Key=detail.author}" />
                    <HyperlinkButton
                        Grid.Row="2"
                        Grid.Column="2"
                        Padding="0"
                        Content="{x:Bind Item.Author}"
                        NavigateUri="{x:Bind Item.AuthorUrl}"
                        Visibility="{x:Bind Item.HasAuthorUrl}" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="2"
                        Style="{StaticResource InfoValueStyle}"
                        Text="{x:Bind Item.Author}"
                        Visibility="{x:Bind Item.HasNoAuthorUrl}" />

                    <FontIcon Grid.Row="3" Glyph="&#xE71B;" Style="{StaticResource InfoIconStyle}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource InfoLabelStyle}" Text="{l:Loc Key=detail.release}" />
                    <HyperlinkButton
                        Grid.Row="3"
                        Grid.Column="2"
                        Padding="0"
                        Content="{x:Bind Item.ReleaseLinkText}"
                        IsEnabled="{x:Bind Item.HasReleaseUrl}"
                        NavigateUri="{x:Bind Item.Package.ReleaseUrl}" />

                    <FontIcon Grid.Row="4" Glyph="&#xE8F1;" Style="{StaticResource InfoIconStyle}" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource InfoLabelStyle}" Text="{l:Loc Key=detail.github}" />
                    <HyperlinkButton
                        Grid.Row="4"
                        Grid.Column="2"
                        Padding="0"
                        Content="{x:Bind Item.RepoText}"
                        IsEnabled="{x:Bind Item.HasRepo}"
                        NavigateUri="{x:Bind Item.RepoUrl}" />

                    <FontIcon Grid.Row="5" Glyph="{x:Bind Item.OriginGlyph}" Style="{StaticResource InfoIconStyle}" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource InfoLabelStyle}" Text="{l:Loc Key=detail.origin}" />
                    <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource InfoValueStyle}" Text="{x:Bind Item.OriginText}" />

                    <FontIcon Grid.Row="6" Glyph="&#xE943;" Style="{StaticResource InfoIconStyle}" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource InfoLabelStyle}" Text="{l:Loc Key=detail.id}" />
                    <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource InfoValueStyle}" Text="{x:Bind Item.Id}" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
