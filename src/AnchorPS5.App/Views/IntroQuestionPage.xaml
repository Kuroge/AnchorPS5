<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AnchorPS5.App.Views.IntroQuestionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:AnchorPS5.App.Localization"
    Background="Transparent"
    Loaded="OnLoaded">

    <Page.Resources>
        <!-- Aparición con rebote del distintivo -->
        <Storyboard x:Name="PopStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BadgeScale" Storyboard.TargetProperty="ScaleX">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BadgeScale" Storyboard.TargetProperty="ScaleY">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Page.Resources>

    <Grid RowDefinitions="*,Auto" RowSpacing="16">
        <StackPanel
            MaxWidth="480"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12">
            <Grid
                Width="88"
                Height="88"
                HorizontalAlignment="Center"
                RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="BadgeScale" ScaleX="0" ScaleY="0" />
                </Grid.RenderTransform>
                <Ellipse>
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="#F2C14E" />
                            <GradientStop Offset="1" Color="#D4AC28" />
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <FontIcon
                    FontSize="40"
                    Foreground="#1C1C1C"
                    Glyph="&#xE7BE;" />
            </Grid>
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="{l:Loc Key=setup.askIntro}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <TextBlock
                Style="{StaticResource SecondaryTextStyle}"
                Text="{l:Loc Key=setup.askIntroDescription}"
                TextAlignment="Center" />
        </StackPanel>

        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                MinWidth="120"
                Click="OnNoClick"
                Content="{l:Loc Key=common.no}" />
            <Button
                MinWidth="120"
                AutomationProperties.Name="{l:Loc Key=common.yes}"
                Click="OnYesClick"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE768;" />
                    <TextBlock Text="{l:Loc Key=common.yes}" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Page>
