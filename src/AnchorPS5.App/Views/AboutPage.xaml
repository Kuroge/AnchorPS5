<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AnchorPS5.App.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:AnchorPS5.App.Controls"
    xmlns:l="using:AnchorPS5.App.Localization"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="AboutIconStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{ThemeResource AnchorBlueBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="AboutLabelStyle" BasedOn="{StaticResource BodyTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <ScrollViewer Padding="32,20,32,32" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="820" Spacing="20">
            <!-- Cabecera -->
            <Border Padding="24" Style="{StaticResource CardStyle}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">
                    <c:AnchorMark
                        Width="72"
                        Height="72"
                        Foreground="{ThemeResource AnchorBlueBrush}"
                        RingBrush="{ThemeResource AnchorGoldBrush}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="AnchorPS5" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{l:Loc Key=app.tagline}" />
                        <TextBlock x:Name="VersionText" Foreground="{ThemeResource AnchorBlueBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Proyecto -->
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{l:Loc Key=about.projectTitle}" />
                <Border Padding="20,14" Style="{StaticResource CardStyle}">
                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="14" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
                        <FontIcon Glyph="&#xE77B;" Style="{StaticResource AboutIconStyle}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource AboutLabelStyle}" Text="{l:Loc Key=detail.author}" />
                        <HyperlinkButton Grid.Column="2" Padding="0" Content="cheyen2008 (Kuroge)" NavigateUri="https://github.com/Kuroge" />

                        <FontIcon Grid.Row="1" Glyph="&#xE8D7;" Style="{StaticResource AboutIconStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource AboutLabelStyle}" Text="{l:Loc Key=about.license}" />
                        <HyperlinkButton Grid.Row="1" Grid.Column="2" Padding="0" Content="GNU GPL v3" NavigateUri="https://github.com/Kuroge/AnchorPS5/blob/main/LICENSE" />

                        <FontIcon Grid.Row="2" Glyph="&#xE943;" Style="{StaticResource AboutIconStyle}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource AboutLabelStyle}" Text="{l:Loc Key=about.sourceCode}" />
                        <HyperlinkButton Grid.Row="2" Grid.Column="2" Padding="0" Content="github.com/Kuroge/AnchorPS5" NavigateUri="https://github.com/Kuroge/AnchorPS5" />

                        <FontIcon Grid.Row="3" Glyph="&#xE8F1;" Style="{StaticResource AboutIconStyle}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource AboutLabelStyle}" Text="{l:Loc Key=about.catalog}" />
                        <HyperlinkButton Grid.Row="3" Grid.Column="2" Padding="0" Content="github.com/Kuroge/AnchorPS5-catalog" NavigateUri="https://github.com/Kuroge/AnchorPS5-catalog" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Problemas y registro -->
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{l:Loc Key=about.problemsTitle}" />
                <Border Padding="20,14" Style="{StaticResource CardStyle}">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="{l:Loc Key=about.problemsText}"
                            TextWrapping="Wrap" />
                        <Button Grid.Column="1" VerticalAlignment="Center" Click="OnOpenLogsClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE838;" />
                                <TextBlock Text="{l:Loc Key=about.openLogs}" />
                            </StackPanel>
                        </Button>
                        <HyperlinkButton
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Content="{l:Loc Key=about.reportIssue}"
                            NavigateUri="https://github.com/Kuroge/AnchorPS5/issues" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Componentes de terceros -->
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{l:Loc Key=about.thirdPartyTitle}" />
                <Border Padding="20,14" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel>
                                <HyperlinkButton Padding="0" Content="7-Zip" NavigateUri="https://www.7-zip.org/" />
                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{l:Loc Key=about.sevenZip}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Center" Click="OnSevenZipLicenseClick" Content="{l:Loc Key=about.viewLicense}" />
                        </Grid>
                        <StackPanel>
                            <HyperlinkButton Padding="0" Content="Windows App SDK" NavigateUri="https://github.com/microsoft/WindowsAppSDK" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{l:Loc Key=about.windowsAppSdk}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel>
                            <HyperlinkButton Padding="0" Content="CommunityToolkit.Mvvm" NavigateUri="https://github.com/CommunityToolkit/dotnet" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{l:Loc Key=about.mvvmToolkit}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Créditos -->
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{l:Loc Key=about.creditsTitle}" />
                <Border Padding="20,14" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap">
                            <Run FontWeight="SemiBold" Text="Huertas34" />
                            <Run Text="{l:Loc Key=about.creditsHuertas}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{l:Loc Key=about.creditsAuthors}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
