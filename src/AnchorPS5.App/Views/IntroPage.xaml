<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AnchorPS5.App.Views.IntroPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:AnchorPS5.App.Localization">

    <!-- Provisional: el tour (pantallas desde intro.json) se implementa en la Fase 4. -->
    <Grid Padding="24">
        <TextBlock
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="{l:Loc Key=nav.guide}" />
        <Button
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Click="OnSkipClick"
            Content="{l:Loc Key=intro.skip}" />
    </Grid>
</Page>
