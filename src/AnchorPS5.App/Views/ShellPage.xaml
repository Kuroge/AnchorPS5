<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AnchorPS5.App.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:AnchorPS5.App.Localization"
    Background="Transparent">

    <!-- Atrás y abrir/cerrar el menú están en la barra de título (MainWindow). -->
    <NavigationView
        x:Name="NavView"
        IsBackButtonVisible="Collapsed"
        IsPaneToggleButtonVisible="False"
        IsSettingsVisible="False"
        IsTitleBarAutoPaddingEnabled="False"
        ItemInvoked="OnItemInvoked"
        PaneDisplayMode="Auto">
        <NavigationView.MenuItems>
            <NavigationViewItem
                x:Name="CatalogItem"
                Content="{l:Loc Key=nav.catalog}"
                Tag="All">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8F1;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItemSeparator />

            <NavigationViewItem Content="{l:Loc Key=nav.downloaded}" Tag="Downloaded">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE896;" />
                </NavigationViewItem.Icon>
                <NavigationViewItem.InfoBadge>
                    <InfoBadge
                        x:Name="DownloadedBadge"
                        Background="{ThemeResource ControlStrongFillColorDefaultBrush}"
                        Visibility="Collapsed" />
                </NavigationViewItem.InfoBadge>
            </NavigationViewItem>
            <NavigationViewItem Content="{l:Loc Key=nav.updates}" Tag="Updates">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE895;" />
                </NavigationViewItem.Icon>
                <NavigationViewItem.InfoBadge>
                    <InfoBadge x:Name="UpdatesBadge" Visibility="Collapsed" />
                </NavigationViewItem.InfoBadge>
            </NavigationViewItem>
            <NavigationViewItem Content="{l:Loc Key=nav.new}" Tag="New">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE735;" />
                </NavigationViewItem.Icon>
                <NavigationViewItem.InfoBadge>
                    <InfoBadge
                        x:Name="NewBadge"
                        Background="#F2C14E"
                        Foreground="#1C1C1C"
                        Visibility="Collapsed" />
                </NavigationViewItem.InfoBadge>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <NavigationView.FooterMenuItems>
            <!-- La guía se conecta en la fase del tour; oculta hasta entonces. -->
            <NavigationViewItem
                Content="{l:Loc Key=nav.guide}"
                SelectsOnInvoked="False"
                Visibility="Collapsed">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE7BE;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="AboutItem" Content="{l:Loc Key=nav.about}" Tag="About">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE946;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <Frame x:Name="ContentFrame" Navigated="OnNavigated" />
    </NavigationView>
</Page>
