<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AnchorPS5.App.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:AnchorPS5.App.Localization">

    <NavigationView
        x:Name="NavView"
        BackRequested="OnBackRequested"
        IsBackButtonVisible="Auto"
        IsSettingsVisible="False"
        PaneDisplayMode="Left">
        <NavigationView.MenuItems>
            <NavigationViewItem
                x:Name="CatalogItem"
                Content="{l:Loc Key=nav.catalog}"
                Icon="Library"
                Tapped="OnCatalogTapped" />
        </NavigationView.MenuItems>
        <NavigationView.FooterMenuItems>
            <!-- La guía se conecta en la Fase 4. -->
            <NavigationViewItem
                Content="{l:Loc Key=nav.guide}"
                Icon="Help"
                SelectsOnInvoked="False" />
        </NavigationView.FooterMenuItems>

        <Frame x:Name="ContentFrame" Navigated="OnNavigated" />
    </NavigationView>
</Page>
