<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:AnchorPS5.App.Controls"
    xmlns:l="using:AnchorPS5.App.Localization"
    x:Class="AnchorPS5.App.Views.SetupPage">

  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.icon">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="Foreground" Value="{DynamicResource AnchorBlueBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16">
    <StackPanel Spacing="6">
      <TextBlock FontSize="28" FontWeight="SemiBold" Text="{l:Loc Key=setup.title}" />
      <TextBlock
          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
          TextWrapping="Wrap"
          Text="{l:Loc Key=setup.subtitle}" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" Padding="0,0,12,0">
      <StackPanel Spacing="8">
        <!-- Idioma -->
        <Border Classes="card">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
            <TextBlock Classes="icon" Text="&#x1F310;" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{l:Loc Key=setup.language}" />
              <TextBlock Classes="caption" Text="{l:Loc Key=setup.languageDescription}" />
            </StackPanel>
            <ComboBox
                x:Name="LanguageBox"
                Grid.Column="2"
                MinWidth="180"
                VerticalAlignment="Center"
                ItemsSource="{Binding ViewModel.Languages}"
                SelectedItem="{Binding ViewModel.SelectedLanguage, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
        </Border>

        <!-- Carpeta de descargas -->
        <Border Classes="card">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" RowDefinitions="Auto,Auto" RowSpacing="12">
            <TextBlock Classes="icon" Text="&#x1F4C1;" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{l:Loc Key=setup.downloadFolder}" />
              <TextBlock Classes="caption" Text="{l:Loc Key=setup.downloadFolderDescription}" />
            </StackPanel>
            <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox x:Name="DownloadPathBox" Text="{Binding ViewModel.DownloadPath, Mode=TwoWay}" />
              <Button Grid.Column="1" Command="{Binding ViewModel.BrowseCommand}" Content="{l:Loc Key=setup.browse}" />
            </Grid>
          </Grid>
        </Border>

        <!-- Cuenta de GitHub (opcional) -->
        <Border Classes="card">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
            <TextBlock Classes="icon" Text="&#x263A;" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{l:Loc Key=github.account}" />
              <TextBlock Classes="caption" Text="{l:Loc Key=setup.githubDescription}" />
            </StackPanel>
            <Button
                x:Name="GitHubSignInButton"
                Grid.Column="2"
                VerticalAlignment="Center"
                Click="OnGitHubSignInClick"
                Content="{l:Loc Key=github.signIn}" />
            <StackPanel
                x:Name="GitHubSignedInPanel"
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10"
                IsVisible="False">
              <c:Avatar x:Name="GitHubPicture" Width="32" Height="32" />
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="GitHubSignedInText" />
                <Button
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="{DynamicResource AnchorBlueBrush}"
                    Click="OnGitHubSignOutClick"
                    Content="{l:Loc Key=github.signOut}" />
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Error (equivalente al InfoBar de WinUI) -->
        <Border
            Padding="12,8"
            CornerRadius="6"
            Background="#33C42B1C"
            IsVisible="{Binding ViewModel.HasError}">
          <TextBlock
              x:Name="ErrorText"
              Foreground="{DynamicResource SystemFillColorCriticalBrush}"
              TextWrapping="Wrap"
              Text="{Binding ViewModel.ErrorMessage}" />
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Button
        x:Name="ConfirmButton"
        Grid.Row="2"
        MinWidth="150"
        HorizontalAlignment="Right"
        HorizontalContentAlignment="Center"
        Classes="accent"
        Command="{Binding ViewModel.ConfirmCommand}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{l:Loc Key=setup.confirm}" />
        <TextBlock Text="&#x2192;" />
      </StackPanel>
    </Button>
  </Grid>
</UserControl>
