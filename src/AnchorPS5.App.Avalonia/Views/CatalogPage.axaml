<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:AnchorPS5.App.Controls"
    xmlns:l="using:AnchorPS5.App.Localization"
    xmlns:vm="using:AnchorPS5.App.ViewModels"
    x:Class="AnchorPS5.App.Views.CatalogPage">

  <Grid Margin="32,20,32,0" RowDefinitions="Auto,Auto,*">
    <!-- Cabecera -->
    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="10">
      <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock FontSize="22" FontWeight="Bold" Text="{Binding ViewModel.Title}" />
        <TextBlock
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{Binding ViewModel.CountText}" />
      </StackPanel>
      <!-- Solo en Actualizaciones, con alguna pendiente -->
      <Button
          Grid.Column="1"
          Classes="accent"
          VerticalAlignment="Center"
          Command="{Binding ViewModel.UpdateAllAppsCommand}"
          IsVisible="{Binding ViewModel.CanUpdateAll}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="&#x2B07;" FontSize="14" />
          <TextBlock Text="{l:Loc Key=action.updateAll}" />
        </StackPanel>
      </Button>
      <ComboBox
          Grid.Column="2"
          MinWidth="150"
          VerticalAlignment="Center"
          ToolTip.Tip="{l:Loc Key=catalog.sort}"
          SelectedIndex="{Binding ViewModel.SortIndex}">
        <ComboBoxItem Content="{l:Loc Key=catalog.sort.name}" />
        <ComboBoxItem Content="{l:Loc Key=catalog.sort.whatsNew}" />
      </ComboBox>
      <TextBox
          Grid.Column="3"
          Width="280"
          VerticalAlignment="Center"
          Watermark="{l:Loc Key=search.placeholder}"
          Text="{Binding ViewModel.SearchText, UpdateSourceTrigger=PropertyChanged}" />
      <Button
          Grid.Column="4"
          VerticalAlignment="Center"
          Command="{Binding ViewModel.ReloadCommand}"
          ToolTip.Tip="{l:Loc Key=catalog.refreshTooltip}">
        <TextBlock Text="&#x27F3;" FontSize="16" />
      </Button>
    </Grid>

    <!-- Avisos -->
    <StackPanel Grid.Row="1" Spacing="8" Margin="0,14,0,0">
      <Border
          CornerRadius="6"
          Background="{DynamicResource AnchorGoldTintBrush}"
          Padding="12,8"
          IsVisible="{Binding ViewModel.HasSourceErrors}">
        <StackPanel Spacing="4">
          <TextBlock Text="{l:Loc Key=catalog.sourceErrors}" FontWeight="SemiBold" />
          <TextBlock
              Text="{Binding ViewModel.SourceErrors}"
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Border
          CornerRadius="6"
          Background="{DynamicResource AnchorGoldTintBrush}"
          Padding="12,8"
          IsVisible="{Binding ViewModel.HasGitHubWarning}">
        <StackPanel Spacing="6">
          <TextBlock Text="{l:Loc Key=github.title}" FontWeight="SemiBold" />
          <TextBlock
              Text="{Binding ViewModel.GitHubWarning}"
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              TextWrapping="Wrap" />
          <StackPanel
              Orientation="Horizontal"
              Spacing="8"
              IsVisible="{Binding ViewModel.IsGitHubRateLimited}">
            <Button
                Classes="accent"
                Click="OnGitHubSignInClick"
                IsVisible="{Binding ViewModel.CanSignInFromWarning}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="&#x263A;" FontSize="13" />
                <TextBlock Text="{l:Loc Key=github.signIn}" />
              </StackPanel>
            </Button>
            <Button
                VerticalAlignment="Center"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                Click="OnLearnMoreClick">
              <TextBlock
                  Foreground="{DynamicResource AnchorBlueBrush}"
                  Text="{l:Loc Key=github.learnMore}" />
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Cuadrícula de apps -->
    <ScrollViewer Grid.Row="2" Margin="0,14,0,0">
      <ItemsControl
          x:Name="Grid"
          ItemsSource="{Binding ViewModel.Items}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:CatalogItemViewModel">
            <Button
                Width="248"
                Height="188"
                Margin="0,0,12,12"
                Padding="16"
                CornerRadius="8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                PointerEntered="OnCardPointerOver"
                PointerExited="OnCardPointerLeave"
                Click="OnCardClick"
                Tag="{Binding}">
              <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                  <Border
                      Width="64"
                      Height="64"
                      CornerRadius="14">
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#1A8CFF" />
                        <GradientStop Offset="1" Color="#003791" />
                      </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                      <TextBlock
                          Text="&#x25A3;"
                          FontSize="28"
                          Foreground="White"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                      <Image
                          Source="{Binding Icon}"
                          Stretch="UniformToFill" />
                    </Grid>
                  </Border>
                  <StackPanel
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Spacing="2">
                    <TextBlock
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        FontSize="12"
                        Text="{Binding Author}"
                        TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>

                <StackPanel
                    Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="6">
                  <Border
                      CornerRadius="10"
                      Padding="8,2"
                      Background="{DynamicResource AnchorBlueTintBrush}"
                      IsVisible="{Binding HasVersion}">
                    <TextBlock
                        Foreground="{DynamicResource AnchorBlueBrush}"
                        FontSize="12"
                        Text="{Binding VersionText}" />
                  </Border>
                  <Border
                      CornerRadius="10"
                      Padding="8,2"
                      Background="{DynamicResource BetaTintBrush}"
                      IsVisible="{Binding HasBeta}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <c:BetaIcon
                          Width="11"
                          Height="11"
                          Foreground="{DynamicResource BetaBrush}" />
                      <TextBlock
                          Foreground="{DynamicResource BetaBrush}"
                          FontSize="12"
                          Text="{Binding BetaText}" />
                    </StackPanel>
                  </Border>
                </StackPanel>

                <!-- Estado en la biblioteca (ocupando la fila inferior). -->
                <Grid
                    Grid.Row="2"
                    VerticalAlignment="Bottom">
                  <StackPanel Spacing="6" IsVisible="{Binding IsBusy}">
                    <ProgressBar
                        IsIndeterminate="{Binding ActiveJob.IsIndeterminate, FallbackValue=True}"
                        Value="{Binding ActiveJob.ProgressValue, FallbackValue=0}"
                        Minimum="0"
                        Maximum="100" />
                    <TextBlock
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        FontSize="12"
                        Text="{Binding ActiveJob.StatusText, FallbackValue=''}"
                        TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <StackPanel
                      Orientation="Horizontal"
                      Spacing="6"
                      IsVisible="{Binding IsIdle}">
                    <TextBlock
                        Text="&#x2B07;"
                        FontSize="14"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        IsVisible="{Binding IsNotDownloaded}" />
                    <TextBlock
                        Text="&#x2713;"
                        FontSize="14"
                        Foreground="{DynamicResource AnchorBlueBrush}"
                        IsVisible="{Binding IsDownloaded}" />
                    <TextBlock
                        Text="&#x2191;"
                        FontSize="14"
                        Foreground="{DynamicResource AnchorGoldBrush}"
                        IsVisible="{Binding HasUpdate}" />
                    <TextBlock
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        FontSize="12"
                        Text="{Binding StatusText}"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center" />
                  </StackPanel>
                </Grid>

                <!-- Nueva -->
                <Border
                    Grid.RowSpan="3"
                    Margin="0,-6,-6,0"
                    Padding="8,2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="{DynamicResource AnchorGoldBrush}"
                    CornerRadius="10"
                    IsVisible="{Binding IsNew}">
                  <TextBlock
                      FontWeight="SemiBold"
                      Foreground="#1C1C1C"
                      FontSize="12"
                      Text="{l:Loc Key=status.new}" />
                </Border>
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Cargando -->
    <StackPanel
        Grid.Row="2"
        Margin="0,64,0,0"
        HorizontalAlignment="Center"
        Spacing="12"
        IsVisible="{Binding ViewModel.IsLoading}">
      <ProgressBar
          IsIndeterminate="True"
          Width="200"
          HorizontalAlignment="Center" />
      <TextBlock
          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
          Text="{l:Loc Key=catalog.loading}" />
    </StackPanel>

    <!-- Vacío / sin resultados -->
    <StackPanel
        Grid.Row="2"
        MaxWidth="420"
        Margin="0,64,0,0"
        HorizontalAlignment="Center"
        Spacing="12"
        IsVisible="{Binding ViewModel.HasStatus}">
      <TextBlock
          FontSize="40"
          Foreground="{DynamicResource TextFillColorTertiaryBrush}"
          Text="&#x2630;"
          HorizontalAlignment="Center" />
      <TextBlock
          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
          Text="{Binding ViewModel.StatusMessage}"
          TextAlignment="Center" />
    </StackPanel>
  </Grid>
</UserControl>
