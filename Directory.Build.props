<Project>
  <PropertyGroup>
    <!-- Versión de la app (SemVer): se cambia solo aquí. La etiqueta (alpha.N, beta.N…) va en
         VersionSuffix; para una versión final se deja vacía. -->
    <VersionPrefix>0.1.1</VersionPrefix>
    <VersionSuffix>alpha.1</VersionSuffix>
    <!-- Sin el "+hash" del commit en la versión que ve el usuario. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Authors>cheyen2008</Authors>
    <Company>cheyen2008</Company>
    <Product>AnchorPS5</Product>
    <Copyright>© cheyen2008</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>
